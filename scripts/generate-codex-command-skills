#!/usr/bin/env node

// Commands were migrated to cmd-* source skills. Keep this generator as a
// compatibility entry point for repositories that still contain commands.
const fs = require("fs");
const path = require("path");
const root = path.resolve(__dirname, "..");
const outputRoot = path.join(root, "generated", "codex-command-skills");
fs.rmSync(outputRoot, { recursive: true, force: true });
for (const plugin of fs.readdirSync(path.join(root, "plugins"))) {
  const commands = path.join(root, "plugins", plugin, "commands");
  if (!fs.existsSync(commands)) continue;
  for (const file of fs.readdirSync(commands).filter((name) => name.endsWith(".md"))) {
    const name = `cmd-${path.basename(file, ".md").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;
    const destination = path.join(outputRoot, plugin, name);
    fs.mkdirSync(destination, { recursive: true });
    fs.copyFileSync(path.join(commands, file), path.join(destination, "SKILL.md"));
    console.log(path.relative(root, path.join(destination, "SKILL.md")));
  }
}
